{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "dev/**/*.ts",
    "src/lib/time.ts",
    "src/lib/slots.ts",
    "src/lib/phone.ts",
    "src/lib/email.ts",
    "src/lib/whatsapp.ts",
    "src/lib/bookingTypes.ts",
    "src/lib/smsCopy.ts",
    "src/lib/emailCopy.ts",
    "src/data/shop.ts"
  ]
}
