# Owner phone board PIN (dev server). Change this before anyone else uses /board.
OWNER_PIN=4821

# SMTP mailbox that sends customer confirmations and owner board alerts.
# python3 dev/send_email.py — stdlib smtplib, no Resend/Twilio.
# Gmail: smtp.gmail.com, port 587, SMTP_USER is the Gmail address, SMTP_PASS is an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
OWNER_EMAIL=

# SMS via Twilio. Leave blank — we are not using SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=+16472223540

# Public site origin used in cancel links inside emails.
PUBLIC_SITE_URL=http://localhost:5176

# Production only: Supabase Edge Function URL that speaks the same /day /book /cancel API.
